includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: max

    ignoreErrors:
        - '#Access to internal property Illuminate\\Console\\Command::\$components from outside its root namespace Illuminate.#'

    paths:
        - app
        - config
        - bootstrap
        - database
        - routes
